# .env.example — copy to .env and fill in your values
# This file is safe to commit. It contains only placeholders and Google's public test IDs.
# Real production values go in CI secrets or EAS environment variables, never in the repo.

# App versioning
TRAKL_APP_VERSION=1.0.9
TRAKL_ANDROID_PACKAGE=com.example.trakl
TRAKL_IOS_BUNDLE_ID=com.example.trakl
TRAKL_ANDROID_VERSION_CODE=22

# Expo / EAS
TRAKL_EXPO_OWNER=your-expo-account
TRAKL_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# AdMob (defaults are Google's official test IDs — safe for development)
TRAKL_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
TRAKL_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
TRAKL_ADMOB_ANDROID_BANNER_UNIT_ID=ca-app-pub-3940256099942544/6300978111
TRAKL_ADMOB_IOS_BANNER_UNIT_ID=ca-app-pub-3940256099942544/2934735716

# App Store / Play Store (leave empty until published)
TRAKL_APP_STORE_APP_ID=
