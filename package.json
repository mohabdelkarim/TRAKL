    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "expo-check": "expo install --check --npm",
    "lint": "oxlint --type-aware --type-check",
    "lint:css": "node scripts/lint-css.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
