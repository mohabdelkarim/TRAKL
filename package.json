  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "expo-check": "expo install --check --npm",
    "lint": "oxlint --type-aware --type-check",
    "lint:css": "node scripts/lint-css.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "knip": "knip",
    "jscpd": "jscpd",
    "ast-grep": "ast-grep scan",
    "semgrep": "semgrep scan --config .semgrep.yml",
    "osv-scanner": "osv-scanner --recursive ./",
    "retirejs": "retire --path . --severity medium",
    "prepare": "node -e \"try{require('child_process').execSync('lefthook install',{stdio:'inherit'})}catch(e){}\"",
    "bundle:android": "expo export --platform android",
    "bundle:ios": "expo export --platform ios"
  },
